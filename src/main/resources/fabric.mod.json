{
	"schemaVersion": 1,
	"id": "macromod",
	"version": "${version}",
	"name": "MacroMod",
	"description": "Client-side macro recorder: record your inputs, look direction, chat and commands, then replay them by name.",
	"authors": [
		"thewhynow"
	],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.thewhynow.macromod.MacroModClient"
		]
	},
	"mixins": [
		"macromod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
